# The original ESP32: Xtensa, dual core, 2.4 GHz only, BLE 4.2, and on every
# board this project targets, no PSRAM. The tightest chip here, which is why the
# board profile that uses it leaves the notifier out.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# A CH340 UART bridge is the only serial connection on these boards, so the
# console is the UART and nothing else. Improv listens there too.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Which board this image is for. The chip does not say: see OBSERVORE_BOARD.
CONFIG_OBSERVORE_BOARD="cyd-2432s028r-st7789"

# The classic ESP32 cannot build an observer-only NimBLE. ESP-IDF forces
# host-based privacy on for this chip (esp_nimble_cfg.h, under
# CONFIG_IDF_TARGET_ESP32), which compiles the address-resolution code, which
# calls the security manager, which is only compiled when a connecting role
# exists. So it gets a central role it will never use; the device still never
# connects to anything. Costs some flash and a little RAM, both measured in the
# PR that added this.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y

# IRAM on the classic ESP32 is 128 KB and the headless build already used 97%
# of it; the display driver overflowed it by 4.4 KB. The SPI master driver
# places its interrupt handler and transaction code in IRAM by default so
# transfers stay fast during flash cache misses. A status screen redrawn every
# two seconds has no use for that, so both go to flash. FreeRTOS and the ring
# buffer likewise: their IRAM placement is a latency optimisation, not a
# correctness one. Measured, in the PR that added the display.
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_MASTER_IN_IRAM=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# A wider BLE scan window than the other targets get (#231).
#
# The classic ESP32 returns far less BLE per unit of duty cycle than the S3
# does. Measured with the boards inches apart, over five minutes each, with
# an untouched S3 captured alongside as a reference -- which mattered, because
# the room drifted by a factor of two between two of the runs and the raw
# counts alone said the wider window made things worse:
#
#   window/interval  duty   CYD sightings  S3 reference  ratio  Wi-Fi frames
#    60/160 (stock)  37%          1614          5191     0.311       1086
#    90/160          56%          2168          4968     0.436        776
#   120/160          75%          2109          4502     0.468        436
#
# 90 is the knee. Going from 60 to 90 buys about forty per cent more BLE for
# twenty-nine per cent of the sniffer; going on to 120 buys almost no further
# BLE -- the raw count is flat -- and costs another forty-four per cent. A
# single measurement at 120, which is where this started, would have chosen
# the worse of the two.
#
# Target-level rather than per board, so a future classic-ESP32 profile gets
# it without anybody remembering. The other targets keep the 60 ms default:
# this is a correction for one chip's arbiter, not a change of policy.
CONFIG_OBSERVORE_BLE_SCAN_WINDOW_MS=90
