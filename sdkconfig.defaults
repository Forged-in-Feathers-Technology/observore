# Settings that hold for every supported target.
#
# Anything chip- or board-specific belongs in sdkconfig.defaults.<target>,
# which ESP-IDF loads automatically on top of this file. Keeping PSRAM or a
# flash size here made them "unknown kconfig symbol" warnings on the RISC-V
# targets, which is the kind of noise that trains people to ignore warnings.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: NimBLE, observer only.  No advertising, no GATT server, nothing
# that would make this device visible to anything it is watching.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Wi-Fi and BLE share one radio; the arbiter has to be on or the sniffer
# starves the BLE scanner.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Sniffing needs the promiscuous RX path and more RX buffers than the default,
# since management frames arrive in bursts on a busy channel.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Every supported target has a native USB serial/JTAG peripheral and the boards
# in question carry no UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Wi-Fi uplink credentials are deliberately EMPTY here -- this file is tracked
# by git.  Set them with `idf.py menuconfig` (sdkconfig is gitignored), or with
# a gitignored credentials.conf, or at runtime from the console.
# See README, "Joining your network".
CONFIG_OBSERVORE_WIFI_SSID=""
CONFIG_OBSERVORE_WIFI_PASSWORD=""

# Notifications go over TLS to whatever host you run, so the Mozilla root
# bundle is compiled in rather than pinning a single certificate.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
