# Settings that hold for every supported target.
#
# Anything chip- or board-specific belongs in sdkconfig.defaults.<target>,
# which ESP-IDF loads automatically on top of this file. Keeping PSRAM or a
# flash size here made them "unknown kconfig symbol" warnings on the RISC-V
# targets, which is the kind of noise that trains people to ignore warnings.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: NimBLE, observer only.  No advertising, no GATT server, nothing
# that would make this device visible to anything it is watching.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Wi-Fi and BLE share one radio; the arbiter has to be on or the sniffer
# starves the BLE scanner.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Sniffing needs the promiscuous RX path and more RX buffers than the default,
# since management frames arrive in bursts on a busy channel.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The default for boards whose only serial connection is the chip's own USB
# peripheral, which is the XIAO ESP32S3 and most C6 boards. The C5 kits carry a
# UART bridge as well and override this in their own defaults file, so that the
# log appears on whichever of their two sockets is plugged in.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Ask DHCP for an NTP server.
#
# Required by observore_clock: without it esp_netif_sntp_init() refuses the
# configuration outright rather than falling back. Taking the server from DHCP
# is the point -- this device is meant to sit on the segment the cameras are
# on, and that segment is routinely firewalled from the internet, so a public
# pool cannot be reached from where the device actually lives. The router's own
# NTP can.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# Wi-Fi uplink credentials are deliberately EMPTY here -- this file is tracked
# by git.  Set them with `idf.py menuconfig` (sdkconfig is gitignored), or with
# a gitignored credentials.conf, or at runtime from the console.
# See README, "Joining your network".
CONFIG_OBSERVORE_WIFI_SSID=""
CONFIG_OBSERVORE_WIFI_PASSWORD=""

# Notifications go over TLS to whatever host you run, so the Mozilla root
# bundle is compiled in rather than pinning a single certificate.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# The common roots rather than the full Mozilla set: 44 authorities instead of
# about 130, for 51 KB less flash. Let's Encrypt (ISRG Root X1 and X2) is
# included, which is what self-hosted notifier endpoints overwhelmingly use.
# A server behind an unusual CA needs DEFAULT_FULL back, or a custom bundle --
# and a private CA needed a custom bundle either way.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# Optimise for size, not for debugging. Worth 125 KB, which matters because the
# OTA layout gives each slot 1984 KB and the C5 is the tightest target.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# TLS needs a contiguous buffer, and this device could not spare one.
#
# Measured, not guessed. A device left running overnight logged 10,019 failed
# notifications and zero successes, every one of them:
#
#   E esp-tls-mbedtls: mbedtls_ssl_setup returned -0x7F00
#
# which is MBEDTLS_ERR_SSL_ALLOC_FAILED. Not a firewall and not DNS -- no
# packet was ever sent, which is why nothing appeared in the network logs.
# mbedTLS wanted one 16384-byte allocation for its inbound record buffer and
# the largest free block was 15360 bytes. Short by a kilobyte, every time, for
# seven hours.
#
# 8 KB halves the contiguous demand and still holds any realistic certificate
# chain in a single record -- a Let's Encrypt chain is around 4 KB. The
# outbound side stays at 4 KB because the requests are a few hundred bytes of
# JSON.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Allocate the TLS record buffers only while they are in use.
#
# Halving the inbound buffer moved the failure on rather than removing it:
# ssl_setup stopped failing and the handshake began failing instead, with
# MBEDTLS_ERR_X509_FATAL_ERROR, at a moment when the minimum free heap was 468
# bytes. The device cannot hold a TLS session open alongside Wi-Fi, BLE and the
# console for the whole of a connection.
#
# Dynamic buffers make mbedTLS allocate on demand and free between phases, so
# the peak lasts milliseconds rather than the life of the connection. This is
# the half of the fix that needs no PSRAM, which is what makes it worth having
# on the C6 as well; the boards that do have PSRAM additionally route mbedTLS
# allocations there, in their own defaults files.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# A new image gets one chance to prove itself.  Without this an update that
# boots but cannot join the network is unrecoverable without a cable, which
# would defeat the point of updating over the air in the first place.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The window a new image has to prove itself before the RTC watchdog resets it
# into the old one.  The default 9 seconds is shorter than one patrol cycle, so
# every update would roll back, good ones included -- measured, not guessed.
# 120000 is the maximum the bootloader accepts, and a patrol cycle completes in
# about 35 seconds, which leaves room for a slow scan without leaving a genuinely
# hung image running for long.
CONFIG_BOOTLOADER_WDT_TIME_MS=120000

# Lets the console close a stalled connection with a reset instead of a FIN
# that waits on a client which has stopped reading. See observore_web_start().
CONFIG_LWIP_SO_LINGER=y
# Half the default TCP send buffer. The console's largest response is 9 KB,
# and this is the amount a stalled client can pin per socket; the extra round
# trips on a LAN are not noticeable, the pinned memory was.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2920
