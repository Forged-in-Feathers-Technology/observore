# Seeed Studio XIAO ESP32S3 -- ESP32-S3R8, 8 MB flash, 8 MB octal PSRAM.
# This is the reference board: every measurement in the README was taken on it.

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM is optional to the firmware -- the console falls back to a smaller
# internal budget without it -- but where it exists it is worth using, because
# it keeps the console's scratch out of the DRAM that Wi-Fi and lwip allocate
# from.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
