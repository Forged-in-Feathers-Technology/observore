# ESP32-C5.  The reason to care about this target is that it is dual-band: it
# can see 5 GHz networks, which every other supported chip is blind to.

# ESP-IDF defaults this target to 2 MB, which the 3 MB application partition
# does not fit -- the build fails at the partition table, before any code is
# compiled.  4 MB is the smallest size found on boards for this chip.  It is
# deliberately the floor rather than the size of any particular board: a chip
# with more flash boots an image configured for less, while an image configured
# for more than the chip has does not boot at all.  The cost is unused flash on
# a 16 MB board, which buys a single image that works everywhere.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# PSRAM is present on the R-suffixed modules (an ESP32-C5-WIFI6-KIT-N16R8 has
# 8 MB of it) and absent on the rest, and a web flasher cannot tell which board
# is on the other end of the cable.  IGNORE_NOTFOUND is what makes one image
# serve both: without it, a board with no PSRAM panics at boot instead of
# starting.  The firmware already expects this -- the console sizes its scratch
# buffers from what it can actually allocate and falls back to a smaller
# internal budget when PSRAM is missing.
#
# Note that IGNORE_NOTFOUND also pins the Wi-Fi and lwip buffer sizes to their
# no-PSRAM defaults on every board, PSRAM or not.  That is a fair trade here:
# the console's scratch is what wanted PSRAM, and it allocates explicitly.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Log to BOTH USB ports, because C5 boards have two and either one can be the
# one in someone's hand.
#
# The ESP32-C5-DevKitC-1 and the Waveshare kit carry a native USB-Serial/JTAG
# port and a separate CH343 UART bridge.  ESP-IDF defaults this target's
# console to USB-Serial/JTAG alone, so a user who plugs into the UART port --
# which flashes perfectly well, including from the browser flasher -- sees the
# ROM and bootloader banners and then nothing at all.  The app looks dead when
# it is running fine.
#
# That is not just confusing, it is the one thing a first-time user cannot
# afford to miss: the console password is printed on the log and nowhere else.
#
# UART0 as primary with USB-Serial/JTAG as secondary puts the log on both
# ports, so whichever cable is plugged in shows it.  The S3 is deliberately
# left alone -- the XIAO has only native USB and no bridge to log to.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Let mbedTLS allocate from PSRAM.
#
# TLS was failing outright on this board: 10,019 consecutive failures overnight,
# first MBEDTLS_ERR_SSL_ALLOC_FAILED and then, once the buffers were halved and
# made dynamic, MBEDTLS_ERR_X509_FATAL_ERROR with the minimum free heap at 336
# bytes. Internal RAM is simply oversubscribed here -- Wi-Fi, BLE, lwip and the
# console all live in roughly 160 KB -- while 8 MB of PSRAM sat unused.
#
# Only set for targets whose modules carry PSRAM. The C6 has none, so it keeps
# the default allocator and its own smaller TLS ceiling.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Which board this image is for. The chip does not say: see OBSERVORE_BOARD.
CONFIG_OBSERVORE_BOARD="devkit-esp32c5"
