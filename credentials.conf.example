# Copy to credentials.conf (gitignored) and fill in, then build with:
#
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;credentials.conf" build
#
# This route exists for reproducible and CI builds.  For a one-off device
# prefer `idf.py menuconfig` (sdkconfig is gitignored) or setting the network
# at runtime from the console, which stores it in NVS and never writes a
# credential to disk in this repo at all.

CONFIG_ARGUS_WIFI_SSID="your-network"
CONFIG_ARGUS_WIFI_PASSWORD="your-password"
