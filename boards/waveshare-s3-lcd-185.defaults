# Waveshare ESP32-S3-Touch-LCD-1.85 -- a round 1.85" 360x360 IPS LCD on an S3
# with 16 MB flash and 8 MB PSRAM.
#
# Radio, screen and touch all work. The watch face is the one thing left off,
# deliberately: see the note at the bottom.
#
# The panel took five things being right at once, and any one of them wrong
# leaves the glass black with no error anywhere:
#
#   reset      expander chip bit 1. Waveshare call it EXIO2 and their own
#              code shifts by (Pin - 1), so their 2 is the chip's 1.
#   sequence   Waveshare's 184-command table, not the driver's own. The
#              stock one resets this panel cleanly and never lights it.
#   variant    register 0x04 answers 00 02 7F 7F, which is the second of the
#              two panels that ship behind this part number.
#   clock      that read is done at 5 MHz. At 40 it answers 00 03 3F BF,
#              which is no variant at all -- it is the same read corrupted.
#   inversion  on. Their table ends with 0x21, and this project calls
#              esp_lcd_panel_invert_color() afterwards, which sent 0x20 and
#              undid it. That alone turns white into black.
#
# What is here was read off the board, not out of the wiki. The wiki has
# already been wrong about this vendor's touch pins, panel power and battery
# sense, so an I2C scan was run on the two candidate bus pairs and this is
# what answered:
#
#   SDA 1  / SCL 3    0x15              CST816 touch
#   SDA 11 / SCL 10   0x20  0x51  0x6B  TCA9554 expander, PCF85063 clock,
#                                       QMI8658 accelerometer
#
# Two things that scan settled which the wiki did not say. The expander is on
# the sensor bus rather than the touch bus -- so the screen's reset line is
# downstream of the bus the clock is on, which makes bus order a constraint on
# bringing the panel up. And the accelerometer is at 0x6B, not the 0x6A its
# datasheet leads with, exactly as on the 1.43.
#
# Still to establish, and deliberately not guessed at here: which expander bit
# is the panel reset and which is the touch reset (the wiki numbers them EXIO1
# upward without saying whether EXIO1 is the chip's P0 or P1), and whether
# there is a battery sense at all.
#
# The console is the chip's own USB-Serial/JTAG; there is no UART bridge, so
# it enumerates as ttyACM.

CONFIG_OBSERVORE_BOARD="waveshare-s3-lcd-185"

# 16 MB, against the 4 MB the partition table is sized for -- the harmless
# direction, as on the 1.43.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8 MB octal PSRAM, the same as the 1.43.
#
# This said quad on the first attempt, on the reasoning that the 1.43 was the
# unusual one. The board disagreed immediately and in the loudest possible
# way -- "PSRAM chip is not connected, or wrong PSRAM line mode", then a boot
# loop. The R8 in ESP32-S3R8 is eight megabytes of octal; R2 is the quad part.
#
# Named explicitly rather than left to a default, because getting it wrong
# does not degrade, it refuses to boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Two buses. The sensors are on the main one so that nothing which already
# reads a clock or an accelerometer has to know the second exists; the touch
# panel gets the auxiliary pins when it is driven.
CONFIG_OBSERVORE_I2C=y
CONFIG_OBSERVORE_I2C_SDA=11
CONFIG_OBSERVORE_I2C_SCL=10
CONFIG_OBSERVORE_I2C_AUX_SDA=1
CONFIG_OBSERVORE_I2C_AUX_SCL=3

# The expander, which nothing needs yet and which the panel will.
CONFIG_OBSERVORE_IOEXP=y
CONFIG_OBSERVORE_IOEXP_I2C_ADDR=0x20

# The clock chip, which is the same part as the 1.43's and at the same
# address. Worth having on day one: it is the only board besides the 1.43 that
# knows what time it is across a power cut.
CONFIG_OBSERVORE_RTC=y
CONFIG_OBSERVORE_RTC_I2C_ADDR=0x51

# The accelerometer, at the address the board reported rather than the one the
# datasheet leads with.
CONFIG_OBSERVORE_MOTION=y
CONFIG_OBSERVORE_MOTION_I2C_ADDR=0x6B

# The screen: an ST77916 over QSPI, four data lines and no D/C pin, the same
# bus shape as the 1.43's AMOLED.
#
# 360x360 and round, so the text grid is the square that fits inside the
# circle -- 254 of the 360 pixels each way, which is 31 columns by 15 rows.
# Narrower than every other board here, and the pages truncate accordingly
# rather than wrapping.
CONFIG_OBSERVORE_DISPLAY=y
CONFIG_OBSERVORE_DISPLAY_ST77916=y
CONFIG_OBSERVORE_DISPLAY_WIDTH=360
CONFIG_OBSERVORE_DISPLAY_HEIGHT=360
CONFIG_OBSERVORE_DISPLAY_INSET_X=53
CONFIG_OBSERVORE_DISPLAY_INSET_Y=53
CONFIG_OBSERVORE_DISPLAY_SCLK=40
CONFIG_OBSERVORE_DISPLAY_CS=21
CONFIG_OBSERVORE_DISPLAY_QSPI_D0=46
CONFIG_OBSERVORE_DISPLAY_QSPI_D1=45
CONFIG_OBSERVORE_DISPLAY_QSPI_D2=42
CONFIG_OBSERVORE_DISPLAY_QSPI_D3=41
CONFIG_OBSERVORE_DISPLAY_MHZ=40

# Inversion ON, because Waveshare's initialisation table ends with 0x21 and
# this project calls esp_lcd_panel_invert_color() after panel_init(). Left at
# the default, that call sends 0x20 straight after the table sent 0x21 and
# undoes it -- which turns white into black and is indistinguishable from a
# panel that was never driven.
CONFIG_OBSERVORE_DISPLAY_INVERT=y

# A real backlight on a pin, unlike the AMOLED which dims by panel command.
CONFIG_OBSERVORE_DISPLAY_BL=5
CONFIG_OBSERVORE_DISPLAY_LDR_GPIO=-1

# No reset pin: it is on the expander. Which line is the thing the wiki does
# not say, so this is a chip bit number settled by trying it.
CONFIG_OBSERVORE_DISPLAY_RST=-1
CONFIG_OBSERVORE_DISPLAY_RST_IOEXP_BIT=1

# Touch: a CST816 at 0x15, on the auxiliary bus rather than the sensors' one,
# with its reset on expander bit 0 -- Waveshare call that line EXIO1 and their
# driver shifts by (Pin - 1), the same offset that puts the panel reset on
# bit 1.
CONFIG_OBSERVORE_TOUCH=y
CONFIG_OBSERVORE_TOUCH_CST816=y
CONFIG_OBSERVORE_TOUCH_ON_AUX_BUS=y
CONFIG_OBSERVORE_TOUCH_I2C_ADDR=0x15
CONFIG_OBSERVORE_TOUCH_SDA=1
CONFIG_OBSERVORE_TOUCH_SCL=3
CONFIG_OBSERVORE_TOUCH_RST_IOEXP_BIT=0
CONFIG_OBSERVORE_TOUCH_IRQ=4

# The watch face. It needed the dial's proportions expressed as fractions of
# its radius first: they were tuned on the 1.43's 466 pixels and written as
# "r minus a constant", which at 360 gave an hour hand 24% of the radius
# where that board has 42%. The 1.43 is unchanged to within a pixel.
#
# The frame buffer is 360x360x2, a quarter of a megabyte, and comes from the
# PSRAM this board has eight of.
CONFIG_OBSERVORE_WATCHFACE=y

# No LED on this board's pin list -- every pin that might have been one is a
# panel data line. Said as a backend rather than as a pin of -1, because -1
# was tried first and produced "gpio_set_level(247): GPIO output gpio_num
# error" on every heartbeat: no board here had ever had no LED, so nothing
# handled it.
CONFIG_OBSERVORE_LED_NONE=y
# The BOOT button, the strapping pin every S3 has.
CONFIG_OBSERVORE_BUTTON_GPIO=0

# The speaker: a PCM5101 I2S DAC into a power amplifier into an 8-ohm 2W
# driver on a header. The only board here with one.
#
# It cannot be detected. The DAC has no I2C address, so the boot scan that
# finds the clock, the accelerometer, the expander and the touch controller
# will never mention it -- and a speaker whose lead is not in the header
# looks identical to one that is. OBSERVORE_AUDIO_SELFTEST is the only way
# to tell, and it is a build option because listening is the test.
#
# Whether it ever sounds is a runtime setting (POST /api/audio?on=1) and it
# starts off: a detector that chirps when it spots something has told the
# room it spotted them.
CONFIG_OBSERVORE_AUDIO=y
CONFIG_OBSERVORE_AUDIO_BCK=48
CONFIG_OBSERVORE_AUDIO_LRCK=38
CONFIG_OBSERVORE_AUDIO_DIN=47

# The microphone, for one purpose: ultrasonic cross-device tracking beacons.
#
# Separate from the speaker above -- different pins, different I2S channel,
# and deliberately a separate build option, because wanting a chirp when a
# threat appears and wanting an open microphone are not the same decision.
#
# It does not record. See observore_ultrasound.h for the band and the
# reasoning; the short version is that the analysis starts at 17 kHz, so the
# frequencies speech lives in are never computed. Listening is off until
# POST /api/mic?on=1, and GET /api/mic answers whether it is on.
CONFIG_OBSERVORE_MIC=y
CONFIG_OBSERVORE_MIC_SCK=15
CONFIG_OBSERVORE_MIC_WS=2
CONFIG_OBSERVORE_MIC_SD=39

# The cell, divided by three into ADC1 channel 7 -- GPIO8.
#
# Not from the wiki, which documents the battery connector and names no sense
# pin at all. Found by reading the four ADC1 pins this board leaves free and
# seeing which behaved like a divider: GPIO6 sat pinned at 3114 mV, GPIO7 at
# 0, GPIO9 wandered across 89-575 mV like the unconnected pin it is, and
# GPIO8 held 1357 mV with three millivolts of spread. Times three that is
# 4.07 V, a charged lithium cell, and three is the same divider the 1.43
# uses.
CONFIG_OBSERVORE_BATTERY=y
CONFIG_OBSERVORE_BATTERY_ADC_CHANNEL=7

# Battery power, which on this board the firmware has to hold on itself.
#
# From the schematic: IO6 is Key_BAT, IO7 is BAT_Control, IO8 is BAT_ADC.
# The power button connects the cell only while it is held down, so without
# something driving BAT_Control high the board comes up and switches off
# again the moment the finger lifts -- which is exactly what it did.
#
# All three were visible from the board before the schematic confirmed them:
# a pull survey showed IO6 held high (its button's pull-up), IO7 held low
# (the latch's pull-down, correct for defaulting to off) and IO8 holding
# 1357 mV against both internal pulls, which is a low-impedance divider and
# not a floating pin. Times three that is 4.07 V, a charged cell.
CONFIG_OBSERVORE_POWER_HOLD_GPIO=7
CONFIG_OBSERVORE_POWER_KEY_GPIO=6

# The whole pin map, from the vendor's schematic and GPIO table, so that
# nobody has to derive it from the board again. Everything above was worked
# out by probing; this is what it turned out to be.
#
#   IO0   boot button          IO21  LCD_CS
#   IO1   TP_SDA               IO33  PSRAM  <- internal, never touch
#   IO2   MIC_WS               IO34  PSRAM
#   IO3   TP_SCL               IO35  PSRAM
#   IO4   TP_INT               IO36  PSRAM
#   IO5   BL_PWM               IO37  PSRAM
#   IO6   Key_BAT              IO38  I2S_LRCK   (speaker)
#   IO7   BAT_Control          IO39  MIC_SD
#   IO8   BAT_ADC              IO40  LCD_SCK
#   IO9   RTC_INT              IO41  LCD_SDA3
#   IO10  I2C SCL              IO42  LCD_SDA2
#   IO11  I2C SDA              IO43  UART_TXD
#   IO12  unallocated          IO44  UART_RXD
#   IO13  unallocated          IO45  LCD_SDA1
#   IO14  SD_SCLK              IO46  LCD_SDA0
#   IO15  MIC_SCK              IO47  I2S_DIN    (speaker)
#   IO16  SD_MISO              IO48  I2S_BCK    (speaker)
#   IO17  SD_MOSI
#   IO18  LCD_TE               EXIO1  TP_RST      EXIO5  IMU_INT1
#   IO19  USB D-               EXIO2  LCD_RST     EXIO6  unconnected
#   IO20  USB D+               EXIO3  SD_CS       EXIO7  unconnected
#                              EXIO4  IMU_INT2    EXIO8  unconnected
#
# Every pin this profile sets is confirmed against that table: the panel's
# six, the two I2C buses, the touch interrupt, the backlight, the three
# speaker lines, the three microphone lines, the battery trio and both
# expander reset bits.
#
# IO33 to IO37 are the octal PSRAM and are listed by the vendor as internal
# occupancy. Nothing here uses them and nothing should; an S3 that loses its
# PSRAM pins does not fail politely.
#
# The expander's last three lines go nowhere. Worth knowing because they
# were driven high during bring-up, hunting for the battery latch that
# turned out to be IO7 -- an experiment that was harmless because these pins
# are not attached to anything, and which could never have worked for the
# same reason.
#
# IO43 and IO44 are a real UART, unused here. This project can read a GPS
# module for the time, and on a board that already has a clock chip that is
# a redundancy rather than a need -- but it is wired if anybody wants it.
#
# The battery divider is R5 200K over R11 100K, so BAT_ADC is the cell over
# three exactly -- which is what this profile already assumed and what the
# bench measured as 1357 mV for a 4.07 V cell.
#
# There is no charging-status signal. The ETA6098's STAT pin drives an
# indicator LED and reaches no GPIO, so the firmware cannot tell charging
# from charged however it is asked. The green and red LEDs on this board are
# USB-present and system-power, both wired straight to their rails. Recorded
# because "show whether it is charging" is an obvious thing to want and the
# answer is that this hardware cannot.
#
# Three things here are unused and would work:
#
#   IO9   RTC_INT. The PCF85063 can raise an alarm, which is how a board
#         would wake itself on a schedule rather than by polling a clock.
#         Open-drain, so it reads as floating until an alarm is pending --
#         which is exactly how it measured.
#   IO18  LCD_TE. The panel's tearing-effect line. Drawing in step with it
#         is how a full-screen redraw stops shearing, which the watch face
#         would notice more than the text pages.
#   IO14/16/17 plus EXIO3 as chip select: a MicroSD slot. This project has
#         wanted somewhere to put history longer than NVS will hold.

# The MicroSD slot. Clock, MISO and MOSI are pins; the chip select is not --
# it is EXIO3, bit 2 of the expander, which the SPI driver cannot reach.
#
# Nothing else is on those three wires, so the select is asserted once and
# left low rather than toggled over I2C around every transaction. SPI3
# because the panel holds SPI2.
CONFIG_OBSERVORE_SDCARD=y
CONFIG_OBSERVORE_SDCARD_SCLK=14
CONFIG_OBSERVORE_SDCARD_MISO=16
CONFIG_OBSERVORE_SDCARD_MOSI=17
CONFIG_OBSERVORE_SDCARD_CS_IOEXP_BIT=2
CONFIG_OBSERVORE_SDCARD_SPI_HOST=2
CONFIG_OBSERVORE_SDCARD_KHZ=20000
