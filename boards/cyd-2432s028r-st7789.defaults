# ESP32-2432S028R, the 2.8" "Cheap Yellow Display", in its ST7789 revision.
#
# Named for the panel controller, not just the product: the same product name
# ships with an ILI9341 in other revisions, a build for one shows garbage on the
# other, and the chip is identical so the flasher cannot tell them apart. The
# ILI9341 revision is boards/cyd-2432s028r-ili9341.defaults.
#
# Pin map as widely documented, verified on the bench:
#
#   ST7789   HSPI  MOSI 13  MISO 12  SCLK 14  CS 15  DC 2  backlight 21
#   XPT2046        MOSI 32  MISO 39  SCLK 25  CS 33  IRQ 36
#   RGB LED        R 4  G 16  B 17  (active low)
#   BOOT           GPIO 0

# The 2.8" ST7789 over HSPI, verified on the bench 2026-09-16: no colour
# inversion, RGB order, X mirrored, Y not. The first light-up was a negative
# with a cyan band and unreadable text; each of those was one setting, and
# each is a build option so the next panel revision is a config change.
CONFIG_OBSERVORE_DISPLAY=y
CONFIG_OBSERVORE_DISPLAY_ST7789=y

# The XPT2046 touch controller on its own SPI pins, defaults as documented
# above. The calibration bounds live in Kconfig and are per-panel.
CONFIG_OBSERVORE_TOUCH=y

# Touch calibration, measured on the bench unit 2026-09-24 by pressing each
# edge with CONFIG_OBSERVORE_TOUCH_LOG_RAW=y: top ~540, bottom 3863, left 244,
# right 3621. The sheet's axes are CROSSED relative to the landscape display --
# raw Y is the screen's horizontal, raw X its vertical -- which a press to the
# left and then to the right at the same height settles in one move. Bounds are
# a property of one panel: the first values here were carried over from another
# board and put every target a row low, which reads as a screen that ignores
# the button you pressed and activates its neighbour.
CONFIG_OBSERVORE_TOUCH_RAW_MIN_X=540
CONFIG_OBSERVORE_TOUCH_RAW_MAX_X=3863
CONFIG_OBSERVORE_TOUCH_RAW_MIN_Y=244
CONFIG_OBSERVORE_TOUCH_RAW_MAX_Y=3621
CONFIG_OBSERVORE_TOUCH_SWAP_XY=y
# CONFIG_OBSERVORE_TOUCH_FLIP_X is not set
# CONFIG_OBSERVORE_TOUCH_FLIP_Y is not set

# The green element of the RGB LED, as a plain active-low LED.
CONFIG_OBSERVORE_LED_MONO=y
CONFIG_OBSERVORE_LED_GPIO=16
CONFIG_OBSERVORE_LED_ACTIVE_LOW=y
CONFIG_OBSERVORE_BUTTON_GPIO=0

# A device with a display does not need to push notifications, and the classic
# ESP32 with no PSRAM is the board least able to afford the TLS behind them.
# CONFIG_OBSERVORE_NOTIFIER is not set

# Half the usual device table, which is 13 KB of internal RAM back.
#
# Measured against the pool allocations actually come from, this board's
# low-water mark was 1,588 bytes over a ten-minute watch, with a 6,144-byte largest
# free block at that point. The device table is the largest single static
# allocation this firmware makes -- 136 bytes a slot, 26 KB at 192 -- and
# PSRAM does not help it, because it is a static array rather than something
# allocated at runtime.
#
# Afterwards its resting free heap went from 11,064 to 23,764 bytes and its
# low-water before the first update check was 20,444. The figure that still
# reads low, 1,468, is the TLS handshake behind that check -- which succeeds.
# Two different numbers, and only one of them is this table's doing: the
# remaining exposure on this board is a two-second peak once per check, not
# its baseline.
CONFIG_OBSERVORE_MAX_DEVICES=96

CONFIG_OBSERVORE_BOARD="cyd-2432s028r-st7789"
