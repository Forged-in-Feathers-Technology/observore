# ESP32-2432S028R, the 2.8" "Cheap Yellow Display", in its ST7789 revision.
#
# Named for the panel controller, not just the product: the same product name
# ships with an ILI9341 in other revisions, a build for one shows garbage on the
# other, and the chip is identical so the flasher cannot tell them apart. The
# ILI9341 revision is boards/cyd-2432s028r-ili9341.defaults.
#
# Pin map as widely documented, verified on the bench:
#
#   ST7789   HSPI  MOSI 13  MISO 12  SCLK 14  CS 15  DC 2  backlight 21
#   XPT2046        MOSI 32  MISO 39  SCLK 25  CS 33  IRQ 36
#   RGB LED        R 4  G 16  B 17  (active low)
#   BOOT           GPIO 0

# The 2.8" ST7789 over HSPI, verified on the bench 2026-09-16: no colour
# inversion, RGB order, X mirrored, Y not. The first light-up was a negative
# with a cyan band and unreadable text; each of those was one setting, and
# each is a build option so the next panel revision is a config change.
CONFIG_OBSERVORE_DISPLAY=y
CONFIG_OBSERVORE_DISPLAY_ST7789=y

# The green element of the RGB LED, as a plain active-low LED.
CONFIG_OBSERVORE_LED_MONO=y
CONFIG_OBSERVORE_LED_GPIO=16
CONFIG_OBSERVORE_LED_ACTIVE_LOW=y
CONFIG_OBSERVORE_BUTTON_GPIO=0

# A device with a display does not need to push notifications, and the classic
# ESP32 with no PSRAM is the board least able to afford the TLS behind them.
# CONFIG_OBSERVORE_NOTIFIER is not set

CONFIG_OBSERVORE_BOARD="cyd-2432s028r-st7789"
